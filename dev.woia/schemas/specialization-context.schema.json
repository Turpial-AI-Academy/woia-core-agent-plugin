{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://woia.dev/schemas/core/v0.5.0/specialization-context.schema.json",
  "description": "Derived trusted scope and policy intersection; it does not grant provider effect authority.",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "composition_id", "status", "current", "department", "project_ref", "task_ref", "organization_ref", "scope", "snapshot_ref", "binding_ref", "binding_revision", "materialized_generation", "loaded_generation", "generic_base", "delta", "active_root", "core", "provider_closure", "exported_slots", "required_gates", "organization_profile_revision", "department_profile_revision", "policy_revision", "source_map_revision", "domain_refs", "descriptors", "permitted_actions", "permitted_outcomes"],
  "properties": {
    "schema": {"const": "dev.woia.specialization-context/v1"},
    "composition_id": {"$ref": "./common.schema.json#/$defs/id"},
    "status": {"const": "qualified"}, "current": {"const": true},
    "department": {"$ref": "./common.schema.json#/$defs/id"},
    "project_ref": {"$ref": "./common.schema.json#/$defs/id"},
    "task_ref": {"$ref": "./common.schema.json#/$defs/ref"},
    "organization_ref": {"type": "string", "minLength": 1},
    "scope": {"$ref": "./specialization-binding.schema.json#/$defs/scope"},
    "snapshot_ref": {"$ref": "./common.schema.json#/$defs/ref"},
    "binding_ref": {"$ref": "./common.schema.json#/$defs/ref"},
    "binding_revision": {"type": "integer", "minimum": 1},
    "materialized_generation": {"type": "integer", "minimum": 0},
    "loaded_generation": {"type": "integer", "minimum": 0},
    "generic_base": {"$ref": "./specialization-binding.schema.json#/$defs/pin"},
    "delta": {"$ref": "./specialization-binding.schema.json#/$defs/pin"},
    "active_root": {"$ref": "./specialization-binding.schema.json#/$defs/pin"},
    "core": {"$ref": "./specialization-binding.schema.json#/$defs/pin"},
    "provider_closure": {"type": "array", "items": {"$ref": "./specialization-binding.schema.json#/$defs/pin"}},
    "exported_slots": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "required_gates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "organization_profile_revision": {"type": ["integer", "null"], "minimum": 1},
    "department_profile_revision": {"type": ["integer", "null"], "minimum": 1},
    "policy_revision": {"type": "integer", "minimum": 1},
    "source_map_revision": {"type": "integer", "minimum": 1},
    "domain_refs": {"type": "array", "items": {"$ref": "./accepted-domain-descriptor.schema.json#/$defs/descriptorRef"}},
    "descriptors": {"type": "array", "items": {"$ref": "./accepted-domain-descriptor.schema.json"}},
    "permitted_actions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "permitted_outcomes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
