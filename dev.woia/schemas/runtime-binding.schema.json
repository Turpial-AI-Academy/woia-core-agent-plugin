{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://woia.dev/schemas/core/v0.5.0/runtime-binding.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "revision",
    "agent_instance_ref",
    "task_ref",
    "harness",
    "materialized_generation",
    "loaded_generation",
    "native_identifiers",
    "state"
  ],
  "properties": {
    "schema": {
      "const": "dev.woia.runtime-binding/v1"
    },
    "id": {
      "$ref": "./common.schema.json#/$defs/id"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "agent_instance_ref": {
      "$ref": "./common.schema.json#/$defs/ref"
    },
    "task_ref": {
      "$ref": "./common.schema.json#/$defs/ref"
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "version"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "root_session_id": {
      "type": "string",
      "minLength": 1,
      "description": "Observed host root-session identity or an explicit session-start token. Required for current custom-agent execution; legacy bindings without it remain historical only."
    },
    "materialized_generation": {
      "type": "integer",
      "minimum": 0
    },
    "loaded_generation": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "native_identifiers": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "state": {
      "enum": [
        "planned",
        "active",
        "released",
        "failed",
        "stale"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
