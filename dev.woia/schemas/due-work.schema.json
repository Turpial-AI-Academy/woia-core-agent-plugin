{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://woia.dev/schemas/core/v0.5.0/due-work.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","id","revision","organization_ref","department","project_ref","rule","subject_ref","dedupe_key","due_at","timezone","state","attempt","fence","claim","blockers","created_at","updated_at"],
  "properties": {
    "schema": {"const":"dev.woia.due-work/v1"},
    "id": {"$ref":"./common.schema.json#/$defs/id"},
    "revision": {"type":"integer","minimum":1},
    "organization_ref": {"type":"string","minLength":1},
    "department": {"$ref":"./common.schema.json#/$defs/id"},
    "project_ref": {"type":"string","minLength":1},
    "rule": {
      "type":"object","additionalProperties":false,"required":["id","version"],
      "properties":{"id":{"$ref":"./common.schema.json#/$defs/id"},"version":{"type":"string","minLength":1}}
    },
    "subject_ref": {"$ref":"./common.schema.json#/$defs/resourceRef"},
    "dedupe_key": {"type":"string","minLength":1},
    "due_at": {"$ref":"./common.schema.json#/$defs/datetime"},
    "timezone": {"type":"string","minLength":1},
    "state": {"enum":["pending","claimed","blocked","completed","cancelled"]},
    "attempt": {"type":"integer","minimum":0},
    "fence": {"type":"integer","minimum":0},
    "claim": {
      "anyOf":[
        {"type":"null"},
        {
          "type":"object","additionalProperties":false,
          "required":["token","worker_id","fence","claimed_at","expires_at"],
          "properties":{
            "token":{"type":"string","minLength":1},
            "worker_id":{"type":"string","minLength":1},
            "fence":{"type":"integer","minimum":1},
            "claimed_at":{"$ref":"./common.schema.json#/$defs/datetime"},
            "expires_at":{"$ref":"./common.schema.json#/$defs/datetime"}
          }
        }
      ]
    },
    "task_ref":{"anyOf":[{"$ref":"./common.schema.json#/$defs/ref"},{"type":"null"}]},
    "last_result_ref":{"anyOf":[{"$ref":"./common.schema.json#/$defs/resourceRef"},{"type":"null"}]},
    "blockers":{"type":"array","items":{"$ref":"./common.schema.json#/$defs/blocker"}},
    "created_at":{"$ref":"./common.schema.json#/$defs/datetime"},
    "updated_at":{"$ref":"./common.schema.json#/$defs/datetime"}
  }
}
