{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://woia.dev/schemas/core/v0.5.0/shared-resource-reference.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "resource_id",
    "resource_type",
    "system_of_record",
    "classification",
    "provenance"
  ],
  "properties": {
    "schema": {
      "const": "dev.woia.shared-resource-reference/v1"
    },
    "resource_id": {
      "type": "string",
      "minLength": 1
    },
    "resource_type": {
      "type": "string",
      "minLength": 1
    },
    "system_of_record": {
      "type": "string",
      "minLength": 1
    },
    "classification": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "locator": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_at",
        "source"
      ],
      "properties": {
        "observed_at": {
          "$ref": "./common.schema.json#/$defs/datetime"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "minimum_fields": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
