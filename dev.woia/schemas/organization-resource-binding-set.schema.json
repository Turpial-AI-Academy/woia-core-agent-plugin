{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://woia.dev/schemas/core/v0.5.0/organization-resource-binding-set.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","id","revision","organization_ref","bindings","updated_at"],
  "properties": {
    "schema":{"const":"dev.woia.organization-resource-binding-set/v1"},
    "id":{"$ref":"./common.schema.json#/$defs/id"},
    "revision":{"type":"integer","minimum":1},
    "organization_ref":{"type":"string","minLength":1},
    "bindings":{
      "type":"array",
      "items":{
        "type":"object","additionalProperties":false,
        "required":["id","resource_type","capability_plugin","system_of_record","classification","contract","binding_ref","access"],
        "properties":{
          "id":{"$ref":"./common.schema.json#/$defs/id"},
          "resource_type":{"type":"string","minLength":1},
          "capability_plugin":{"$ref":"./common.schema.json#/$defs/id"},
          "system_of_record":{"type":"string","minLength":1},
          "classification":{"enum":["public","internal","confidential","restricted"]},
          "contract":{
            "type":"object","additionalProperties":false,"required":["id","version"],
            "properties":{
              "id":{"type":"string","minLength":1},
              "version":{"type":"string","minLength":1},
              "digest":{"anyOf":[{"$ref":"./common.schema.json#/$defs/sha256"},{"type":"null"}]}
            }
          },
          "binding_ref":{"type":"string","minLength":1},
          "source_authority_map_ref":{"anyOf":[{"$ref":"./common.schema.json#/$defs/resourceRef"},{"type":"null"}]},
          "effective_from":{"anyOf":[{"$ref":"./common.schema.json#/$defs/datetime"},{"type":"null"}]},
          "effective_until":{"anyOf":[{"$ref":"./common.schema.json#/$defs/datetime"},{"type":"null"}]},
          "access":{
            "type":"array","minItems":1,
            "items":{
              "type":"object","additionalProperties":false,"required":["department","purposes","operations","minimum_fields"],
              "properties":{
                "department":{"$ref":"./common.schema.json#/$defs/id"},
                "purposes":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
                "operations":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
                "minimum_fields":{"type":"array","items":{"type":"string","minLength":1}}
              }
            }
          }
        }
      }
    },
    "updated_at":{"$ref":"./common.schema.json#/$defs/datetime"}
  }
}
