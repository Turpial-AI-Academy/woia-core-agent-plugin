{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://woia.dev/schemas/core/v0.5.0/improvement-candidate.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "revision",
    "task_ref",
    "created_by_ref",
    "target_scope",
    "category",
    "problem",
    "proposal",
    "expected_impact",
    "risk",
    "status",
    "evidence"
  ],
  "properties": {
    "schema": {
      "const": "dev.woia.improvement-candidate/v1"
    },
    "id": {
      "$ref": "./common.schema.json#/$defs/id"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "task_ref": {
      "$ref": "./common.schema.json#/$defs/ref"
    },
    "created_by_ref": {
      "$ref": "./common.schema.json#/$defs/ref"
    },
    "target_scope": {
      "enum": [
        "project",
        "organization",
        "global-plugin"
      ]
    },
    "target_plugin": {
      "type": [
        "string",
        "null"
      ]
    },
    "category": {
      "enum": [
        "procedure",
        "skill",
        "deterministic-tool",
        "workflow",
        "template",
        "evaluation",
        "policy",
        "documentation",
        "orchestration"
      ]
    },
    "problem": {
      "type": "string",
      "minLength": 1
    },
    "proposal": {
      "type": "string",
      "minLength": 1
    },
    "expected_impact": {
      "type": "string",
      "minLength": 1
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "summary"
      ],
      "properties": {
        "level": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "status": {
      "enum": [
        "proposed",
        "under-review",
        "accepted-local",
        "submitted-upstream",
        "rejected",
        "promoted",
        "superseded"
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "overlay_ref": {
      "anyOf": [
        {
          "$ref": "./common.schema.json#/$defs/ref"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
