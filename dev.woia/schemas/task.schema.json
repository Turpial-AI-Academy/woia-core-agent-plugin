{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://woia.dev/schemas/core/v0.5.0/task.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "revision",
    "objective",
    "department",
    "workflow_profile",
    "state",
    "owner",
    "inputs",
    "constraints",
    "expected_outputs",
    "evidence_requirements",
    "capability_snapshot_refs",
    "blockers",
    "human_review"
  ],
  "properties": {
    "schema": {
      "const": "dev.woia.task/v1"
    },
    "id": {
      "$ref": "./common.schema.json#/$defs/id"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "department": {
      "$ref": "./common.schema.json#/$defs/id"
    },
    "origin": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "human-request",
            "cross-department-request",
            "service-request",
            "task",
            "import"
          ]
        }
      }
    },
    "workflow_profile": {
      "enum": [
        "direct-service",
        "task-execution",
        "planned-execution",
        "audited-execution",
        "opea-h-full",
        "software-methodology"
      ]
    },
    "state": {
      "enum": [
        "draft",
        "ready",
        "active",
        "waiting",
        "approval-required",
        "blocked",
        "handoff-pending",
        "completed",
        "failed",
        "cancelled",
        "superseded"
      ]
    },
    "current_phase": {
      "type": [
        "string",
        "null"
      ]
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "human",
            "agent-instance"
          ]
        },
        "id": {
          "$ref": "./common.schema.json#/$defs/id"
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "./common.schema.json#/$defs/resourceRef"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "expected_outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "capability_snapshot_refs": {
      "type": "array",
      "items": {
        "$ref": "./common.schema.json#/$defs/ref"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "$ref": "./common.schema.json#/$defs/blocker"
      }
    },
    "human_review": {
      "enum": [
        "not-required",
        "pending",
        "accepted",
        "changes-requested"
      ]
    },
    "current_checkpoint_ref": {
      "anyOf": [
        {
          "$ref": "./common.schema.json#/$defs/ref"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
