{
  "schema": "dev.woia.core-manifest/v1",
  "version": "0.5.3",
  "skills": [
    "project-runtime",
    "opea-h",
    "project-improvement"
  ],
  "schemas": [
    "common",
    "project-state",
    "task",
    "task-cell",
    "agent-definition",
    "agent-instance",
    "runtime-binding",
    "execution-receipt",
    "effect-record",
    "improvement-candidate",
    "overlay",
    "effective-capability-snapshot",
    "checkpoint",
    "self-evaluation",
    "error-record",
    "workflow-profile",
    "organization-registry",
    "authority-context",
    "shared-resource-reference",
    "cross-department-message",
    "due-work",
    "cross-department-delivery",
    "organization-resource-binding-set",
    "project-resource-resolution",
    "orchestrator-composition-snapshot"
  ],
  "workflow_profiles": [
    "direct-service",
    "task-execution",
    "planned-execution",
    "audited-execution",
    "opea-h-full"
  ],
  "storage_root": ".woia",
  "source_lineage": {
    "foundation_repository": "Therenovatioai/woia-foundation",
    "asps_repository": "Turpial-AI-Academy/asps-agent-plugin",
    "extraction_policy": "carry-forward-invariants-not-monolith-runtime"
  },
  "deterministic_tools": [
    {
      "id": "agent.thread.lifecycle",
      "path": "skills/project-runtime/scripts/agent-thread-lifecycle.mjs",
      "purpose": "Reserve and reuse one native thread per AgentInstance and root session, issue independent runs/receipts, and checkpoint failures before fresh-session recovery."
    },
    {
      "id": "authority.guard.require",
      "path": "skills/project-runtime/scripts/authority-guard.mjs",
      "purpose": "Fail closed unless an AgentInstance has an exact capability/operation/effect-class authority grant before a provider-owned mutation."
    },
    {
      "id": "project.bootstrap",
      "path": "skills/project-runtime/scripts/bootstrap-project.mjs",
      "purpose": "Idempotently create/reconcile Project state and the managed AGENTS block."
    },
    {
      "id": "overlay.compatibility.set",
      "path": "skills/project-improvement/scripts/set-overlay-compatibility.mjs",
      "purpose": "Change overlay compatibility metadata without changing customization payload."
    },
    {
      "id": "capability.snapshot.create",
      "path": "skills/project-improvement/scripts/create-capability-snapshot.mjs",
      "purpose": "Create a deterministic effective-capability pin/digest for a Task."
    },
    {
      "id": "due-work.transition",
      "path": "skills/project-runtime/scripts/due-work-state.mjs",
      "purpose": "Apply fenced Due Work claim, retry, block, resume and completion transitions without granting business authority."
    },
    {
      "id": "cross-department.delivery.transition",
      "path": "skills/project-runtime/scripts/cross-department-delivery-state.mjs",
      "purpose": "Track durable request delivery, unknown transport, receiver activation, acceptance, correlated result and recovery as distinct states."
    },
    {
      "id": "project.resources.resolve",
      "path": "skills/project-runtime/scripts/resolve-project-resources.mjs",
      "purpose": "Resolve minimum organization-owned versioned resources for one Project department and purpose without copying secrets or unrelated organization data."
    },
    {
      "id": "orchestrator.composition.snapshot.create",
      "path": "skills/project-improvement/scripts/create-orchestrator-composition-snapshot.mjs",
      "purpose": "Pin an exact independently released generic-base plus delta pair and evaluated provider closure for in-flight Task reproducibility."
    }
  ]
}
